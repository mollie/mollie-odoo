<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="method_form" inherit_id="payment.method_form">
        <label t-out="pm_sudo.name" position="after">
            <t t-if="sale_order">
                <t t-set="website_sale_order" t-value="sale_order" />
            </t>
            <t t-set="show_fees" t-value="provider_sudo.code == 'mollie' and pm_sudo.fees_active and website_sale_order"/>
            <t t-if="show_fees and provider_sudo.mollie_fees_product_id">
                <t t-set="mollie_method_fees" t-value="pm_sudo._compute_fees(amount, website_sale_order.partner_id.country_id, provider_sudo)"/>
                <span t-if="mollie_method_fees" class="badge rounded-pill text-bg-warning">
                    Charges: <span t-out="mollie_method_fees" class="monetary_field" style="white-space: nowrap;"
                    t-options='{"widget": "monetary", "display_currency": website_sale_order.currency_id}'/> + Taxes
                </span>
            </t>
            <span t-elif="show_fees and not provider_sudo.mollie_fees_product_id and request.env.user._is_system()"
                    class="badge rounded-pill text-bg-warning">
                    Mollie fees product not configured
            </span>
        </label>
    </template>
    <template id="token_form" inherit_id="payment.token_form">
        <label t-out="token_sudo.payment_method_id.name" position="after">
            <t t-if="sale_order">
                <t t-set="website_sale_order" t-value="sale_order" />
            </t>
            <t t-if="token_sudo.payment_method_id.is_primary">
                <t t-set="pm_sudo" t-value="token_sudo.payment_method_id"/>
            </t>
            <t t-else="">
                <t t-set="pm_sudo" t-value="token_sudo.payment_method_id.primary_payment_method_id"/>
            </t>
            <t t-set="show_fees" t-value="provider_sudo.code == 'mollie' and pm_sudo.fees_active and website_sale_order"/>
            <t t-if="show_fees and provider_sudo.mollie_fees_product_id">
                <t t-set="mollie_method_fees" t-value="pm_sudo._compute_fees(amount, website_sale_order.partner_id.country_id, provider_sudo)"/>
                <span t-if="mollie_method_fees" class="badge rounded-pill text-bg-warning">
                    Charges: <span t-out="mollie_method_fees" class="monetary_field" style="white-space: nowrap;"
                    t-options='{"widget": "monetary", "display_currency": website_sale_order.currency_id}'/> + Taxes
                </span>
            </t>
            <span t-elif="show_fees and not provider_sudo.mollie_fees_product_id and request.env.user._is_system()"
                    class="badge rounded-pill text-bg-warning">
                    Mollie fees product not configured
            </span>
        </label>
    </template>

</odoo>
