<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="PaymentScreen" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('paymentmethod')]" position="attributes">
            <attribute name="t-if">checkVoucher(paymentMethod)</attribute>
        </xpath>
        <xpath expr="//div[hasclass('payment-name')]" position="after">
            <div class="voucher-amount" t-if="paymentMethod.mollie_voucher_category">
                <t t-esc="getVoucherAmountDisplayText(paymentMethod)" />
            </div>
        </xpath>
    </t>

</templates>
