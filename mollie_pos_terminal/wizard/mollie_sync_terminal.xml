<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sync_mollie_terminal_view_form" model="ir.ui.view">
        <field name="name">sync_mollie_terminal_view_form</field>
        <field name="model">sync.mollie.terminal</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="provider_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <div class="text-center" invisible="not provider_id or api_key_set">
                    <i class="oi d-inline-block p-3 fs-4 rounded-circle text-danger bg-danger bg-opacity-25" data-icon="warning" title="Warning" aria-hidden="true"></i>
                    <h3>Api key is not set.</h3>
                    <p>Please set the API key on the Mollie payment provider.</p>
                </div>
                <div class="text-muted small" invisible="not api_key_set">
                    This operation will sync terminal list from mollie. Then you can select the terminal from the list to use in POS.
                </div>
                <field name="api_key_set" invisible="1"></field>
                <footer>
                    <button string="Sync Now" class="btn btn-primary" type="object" name="sync_now" invisible="not api_key_set"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
